# Токен вашего Telegram-бота от @BotFather
BOT_TOKEN=

# API ключ от Кинопоиска (https://kinopoiskapiunofficial.tech)
KINOPOISK_API_KEY=71c5dd47-2ab2-40d4-bb00-4974097af5b6

# Путь к локальной SQLite базе данных
DATABASE_PATH=bot_database.db

# --- Ограничение нагрузки на CPU и защита VPS ---
# Лимит ядер CPU для Docker (например, 0.8 для 1-ядерной VPS, чтобы SSH и система не зависали)
DOCKER_CPUS=0.8

# Количество потоков PyTorch/BLAS для расчетов (1 поток идеален для слабых VPS)
CPU_THREADS=1

# Максимальное количество одновременных апдейтов Telegram
TELEGRAM_CONCURRENT_UPDATES=4

